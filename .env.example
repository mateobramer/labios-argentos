# Configuración de la demo (demo/*.py) — copiar a .env NO hace falta: son variables
# de entorno normales; exportalas en tu shell o pasalas inline. Todos los defaults
# reproducen el comportamiento histórico (repo en ~/Desktop, envs de miniconda).
# Documentación: docs/DATA_AND_ARTIFACTS.md §Configuración.

# --- Paths ---
# Raíz de este repo. Default: se deriva de la ubicación del script (cualquier clone anda).
#LABIOS_REPO=~/Desktop/labios-argentos

# Clon del repo ViSpeR con visper_vsr_base.pth (1.1 GB, no se versiona).
#VISPER_DIR=~/Desktop/visper

# Intérprete del env conda de inferencia (PyTorch + ESPnet).
#VISPER_PY=~/miniconda3/envs/visper/bin/python

# Solo score_selftest.py --model ft05:
#MVSR_REPO=~/Desktop/Visual_Speech_Recognition_for_Multiple_Languages
#FT05_CKPT=modelos/ft05_espnet1.pth   # default: <repo>/modelos/ft05_espnet1.pth

# --- Knobs de inferencia (ver docs/SPEC.md §3.1 y docs/experiments/09_velocidad_inferencia.md) ---
#VSR_BEAM=3            # beam del decoder (3 = punto de Pareto; 5 si VSR_QWEN=1)
#VSR_QWEN=0            # 1 = corrector qwen n-best rescoring (necesita Ollama local)
#VSR_QMODEL=qwen3:4b-instruct-2507-q4_K_M
#VSR_CKPT=             # state_dict alternativo (p. ej. modelos/personal/<nombre>.pth)
#VSR_MPS=1             # 0 fuerza encoder en CPU (sin Apple Silicon)
