# ══ POLÍTICA DE DATOS (2026-07, ver docs/DATA_AND_ARTIFACTS.md) ══
# Git: código, docs, configs, splits, manifests chicos, muestras mínimas, reportes.
# Bucket: videos, clips masivos, ROIs, checkpoints, manifests gigantes.
# Local/privado: grabaciones personales y modelos calibrados.
# Los datos pesados históricos siguen recuperables desde el commit pre-limpieza a11f0827666b11c975df4d8c5b0d6014894e8ee8
# y el tag dataset-clean-v1 (ver data/README.md).

# Media pesada: no se versiona por accidente. La muestra de smoke vive en data/samples/
# (whitelisted abajo) y los datos masivos en los buckets.
*.mp4
*.webm
*.mkv
*.mov
*.avi
*.wav
*.mp3
*.flac
*.m4a
!data/samples/**

# Pesos y checkpoints (viven en gs://labios-argentos-vsr-dataset)
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx

# ROIs y datos derivados pesados (regenerables con preprocessing/)
*.npz
data/processed/
data/clips/
data/videos/
dataset/
vsr/evaluation/data/
cleaning/transcript_segmentation/outputs/

# Analisis local Azzaro: el video y los clips se regeneran desde el notebook.
# Los JSON de transcripcion dentro de transcripts/ si se versionan como cache.
vsr/evaluation/outputs/azzaro_whisper/videos/
vsr/evaluation/outputs/azzaro_whisper/clips*/
vsr/evaluation/outputs/azzaro_whisper/*.csv
vsr/evaluation/outputs/azzaro_whisper/transcripts_word_timestamps_v2/

# Batch VSR: overlays y ROIs generables; versionar solo configs/manifests livianos.
vsr/evaluation/outputs/batch_vsr/transcripts_current/
vsr/evaluation/outputs/batch_vsr/transcripts_cleaned_restricted/
vsr/evaluation/outputs/batch_vsr/transcripts_cleaned_stronger/
vsr/evaluation/outputs/batch_vsr/rois_lower_face_resized96/
vsr/evaluation/outputs/batch_vsr/preprocessing_variant_smoke/
vsr/evaluation/outputs/batch_vsr/preprocessing_variant_preview/
vsr/evaluation/outputs/batch_vsr/raw/
vsr/evaluation/outputs/batch_vsr/preprocessing_variant_smoke/**/*.npz
vsr/evaluation/outputs/batch_vsr/rois_lower_face_resized96/**/*.npz
vsr/evaluation/outputs/batch_vsr/preprocessing_variant_preview/**/*.png
vsr/runs/batch_vsr/

# Video local usado por el analisis de limpieza; los artefactos finales si se versionan.
cleaning/visual_quality/outputs/azzaro_whisper/videos/
cleaning/visual_quality/outputs/visual_quality_audit/previews/
data/metadata/visual_quality_*_full_roi.csv

# Manifests de análisis de calidad >5 MB: retirados del repo (recuperables desde
# el commit pre-limpieza a11f0827666b11c975df4d8c5b0d6014894e8ee8/tag; ver data/README.md). No re-agregarlos sin decisión explícita.
data/metadata/visual_quality_policy_*.csv
data/metadata/visual_quality_*_full_roi_sanity.csv

# Cache de Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.jupyter_logs/
.ai/

# Entornos virtuales (libs pesadas, no versionar)
.env
.venv/
.venv-visual/
.venv-cleaning/

# Basura del SO / configs locales
.DS_Store
.claude/
.git.broken-backup/
.claude/scheduled_tasks.lock
**/sample-clips/
*.zip

# vsr/mpc001: repo externo clonado (github) y corridas locales — no versionar.
# Se versionan notes/ y scripts/.
vsr/mpc001/repo/
vsr/mpc001/runs/

# curriculum: logs de procesamiento regenerables
vsr/curriculum/logs/
data/_visper_tmp/

# Datos personales (privacidad, regla dura): grabaciones y modelos calibrados
modelos/personal/

# Feedback local de la demo (correcciones humanas; privado, no se versiona)
data/feedback/
.gpu_guardian.sh
.gpu_guardian.log
.demo_run.log
